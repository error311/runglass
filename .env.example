# RunGlass optional local overrides
#
# Copy this to .env or export the values in your shell if you want to
# change the default lightweight behavior for this repository.

# Optional: override the per-file snapshot cap.
# Default in RunGlass is 10 MiB.
# Examples:
#  - 20 MiB: 20971520
#  - 100 MiB: 104857600
# RUNGLASS_MAX_SNAPSHOT_BYTES=20971520
