.el .ds Aq '
.TH runglass-report 1 2026-05-15 "runglass 0.3.0" "RunGlass Manual"
.SH NAME
runglass\-report
.SH SYNOPSIS
\fBrunglass report\fR [\fB\-\-print\-json\fR] [\fB\-\-ai\fR] [\fB\-\-open\fR] [\fB\-\-no\-open\fR] [\fB\-\-port\fR] [\fB\-h\fR|\fB\-\-help\fR] <\fIRUN_ID\fR> 
.SH DESCRIPTION
.SH OPTIONS
.TP
\fB\-\-print\-json\fR

.TP
\fB\-\-ai\fR
Print a compact AI\-friendly receipt summary
.TP
\fB\-\-open\fR
Open the local receipt UI in your browser
.TP
\fB\-\-no\-open\fR
Serve the receipt UI without opening a browser
.TP
\fB\-\-port\fR \fI<PORT>\fR [default: 0]
Port to bind, or 0 for any free port
.TP
\fB\-h\fR, \fB\-\-help\fR
Print help
.TP
<\fIRUN_ID\fR>

